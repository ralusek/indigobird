{
  "name": "indigobird",
  "version": "1.0.0",
  "description": "A complement to bluebird which is also probably slightly better.",
  "keywords": [
    "bluebird",
    "promise",
    "promises",
    "concurrency",
    "map",
    "forEach",
    "simultaneous",
    "parallel",
    "some",
    "any",
    "all",
    "partial",
    "success",
    "functional"
  ],
  "author": "Tomas Savigliano",
  "license": "MIT",
  "main": "./lib/index.js",
  "files": [
    "/lib"
  ],
  "scripts": {
