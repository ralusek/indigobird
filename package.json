      "pre-commit": "npm run build"
    }
  },
  "devDependencies": {
    "@types/chai": "^4.2.11",
    "@types/mocha": "^7.0.2",
    "@types/node": "12.7.5",
    "@types/uuid": "3.4.5",
    "@types/validator": "10.11.3",
    "bluebird": "3.7.2",
    "chai": "4.2.0",
    "husky": "4.2.5",
    "mocha": "7.1.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.1.1",
    "tslint": "^6.1.3",
    "typescript": "^5.3.3",
    "typescript-transform-paths": "^3.4.6"
  }
